<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <!-- Console command section -->
    <type name="Magento\Framework\Console\CommandList">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="feed:buffer" xsi:type="object">BKubicki\RabbitMqPlayground\Console\Command\FeedBufferCommand</item>
                <item name="feed" xsi:type="object">BKubicki\RabbitMqPlayground\Console\Command\FeedCommand</item>
                <item name="mass-feed" xsi:type="object">BKubicki\RabbitMqPlayground\Console\Command\MassFeedCommand</item>
            </argument>
        </arguments>
    </type>
    <!-- End of console command section -->

    <!--  Constructor arguments injection section -->
    <type name="BKubicki\RabbitMqPlayground\Queue\Consumer\RetryConsumerHandler">
        <arguments>
            <argument name="envelopeCallbackType" xsi:type="string">BKubicki\MessageQueue\Queue\Consumer\EnvelopeCallback\RetryLimit</argument>
        </arguments>
    </type>
    <!--  End of constructor arguments injection section -->
</config>
